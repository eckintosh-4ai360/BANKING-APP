# Local development only. Copy to .env (never committed) and adjust as you like.
# These values match the defaults of the Spring 'local' profile, so the API also works when run from an IDE.
# Deployed environments get their secrets from a secret manager, never from files in this repository.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local
DB_MIGRATOR_PASSWORD=banking_migrator_local
DB_APP_PASSWORD=banking_app_local
REDIS_PASSWORD=banking_redis_local
